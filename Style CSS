*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f5f5f5;
}

header{
    background:#111;
    color:white;
    text-align:center;
    padding:30px;
}

header h1{
    font-size:40px;
}

nav{
    background:#222;
    text-align:center;
    padding:15px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:20px;
}

.hero{
    background:white;
    text-align:center;
    padding:60px 20px;
}

.hero h2{
    font-size:35px;
}

.hero p{
    margin:15px;
}

button{
    background:#111;
    color:white;
    padding:12px 30px;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

.products{
    display:flex;
    justify-content:center;
    gap:25px;
    padding:40px;
    flex-wrap:wrap;
}

.card{
    background:white;
    width:250px;
    padding:25px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 0 10px #ccc;
}

footer{
    background:#111;
    color:white;
    text-align:center;
    padding:15px;
}
